DATABASE_URL="postgresql://postgres:postgres@localhost:5432/support_tickets?schema=public"
PORT=3000
JWT_ACCESS_SECRET="genere-avec-openssl-rand-hex-32"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_DAYS=7
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"
APP_URL="http://localhost:3000"
RATE_LIMIT_MAX=300
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="change-me"

# IA (première réponse automatique aux tickets)
# Mettre AI_ENABLED=true seulement quand AI_API_KEY et AI_MODEL sont remplis
AI_ENABLED=false
AI_API_KEY=""
AI_MODEL=""
# Laisser vide pour utiliser l'adresse officielle d'OpenAI
AI_BASE_URL=""
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=1000

# Limites qui protègent le budget IA
# Tickets maximum par compte USER sur 24 heures glissantes (AGENT, ADMIN et SUPER_ADMIN ne sont pas limités)
TICKETS_PER_USER_PER_DAY=10
# Appels IA maximum par jour pour toute l'API (à ajuster selon le plafond du budget)
AI_MAX_CALLS_PER_DAY=100
