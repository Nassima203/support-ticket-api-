generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Ticket {
  id          Int          @id @default(autoincrement())
  title       String       @db.VarChar(150)
  description String
  status      TicketStatus @default(OPEN)
  // L'utilisateur qui a créé le ticket
  authorId    Int
  author      User         @relation(fields: [authorId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([authorId])
  @@map("tickets")
}

// Les 4 rôles, du plus puissant au moins puissant
enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
  USER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  // Vide tant que la personne n'a pas accepté son invitation
  passwordHash String?
  role         Role     @default(USER)
  // false = compte désactivé, la personne ne peut plus se connecter
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tickets             Ticket[]
  invitations         Invitation[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogsDone       AuditLog[]           @relation("AuditActor")
  auditLogsReceived   AuditLog[]           @relation("AuditTarget")

  @@map("users")
}

// Invitation envoyée par email : valable 48 h, utilisable une seule fois
model Invitation {
  id        Int       @id @default(autoincrement())
  // Empreinte du jeton : le jeton lui-même n'est jamais stocké
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("invitations")
}

// Session de connexion : révoquée à la déconnexion ou quand elle est renouvelée
model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Lien « mot de passe oublié » : valable 1 h, utilisable une seule fois
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

// Actions sensibles enregistrées dans le journal d'audit
enum AuditAction {
  USER_CREATED
  USER_DEACTIVATED
  USER_REACTIVATED
  ROLE_CHANGED
  PASSWORD_RESET
}

// Journal d'audit : une ligne par action sensible, jamais modifiée ni supprimée par l'API
model AuditLog {
  id           Int         @id @default(autoincrement())
  action       AuditAction
  // Qui a fait l'action
  actorId      Int?
  actor        User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  // Le compte concerné
  targetUserId Int?
  targetUser   User?       @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  // Détails utiles, par exemple { "from": "USER", "to": "AGENT" } pour un changement de rôle
  details      Json?
  createdAt    DateTime    @default(now())

  @@index([targetUserId])
  @@index([createdAt])
  @@map("audit_logs")
}
