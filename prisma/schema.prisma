generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// Où en est la réponse automatique de l'IA pour un ticket
enum AiStatus {
  SKIPPED   // l'IA n'a pas été appelée (désactivée ou limite du jour atteinte)
  PENDING   // l'IA est en train de répondre
  SUCCEEDED // l'IA a répondu, sa réponse est dans les messages du ticket
  FAILED    // l'appel a échoué, un humain doit prendre le relais
}

model Ticket {
  id          Int          @id @default(autoincrement())
  title       String       @db.VarChar(150)
  description String
  status      TicketStatus @default(OPEN)
  // Réponse automatique de l'IA (SKIPPED tant que l'IA n'est pas appelée)
  aiStatus    AiStatus     @default(SKIPPED)
  // L'utilisateur qui a créé le ticket
  authorId    Int
  author      User         @relation(fields: [authorId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  messages TicketMessage[]
  aiCalls  AiCall[]

  @@index([status])
  @@index([authorId])
  @@map("tickets")
}

// Les 4 rôles, du plus puissant au moins puissant
enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
  USER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  // Vide tant que la personne n'a pas accepté son invitation
  passwordHash String?
  role         Role     @default(USER)
  // false = compte désactivé, la personne ne peut plus se connecter
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tickets             Ticket[]
  invitations         Invitation[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogsDone       AuditLog[]           @relation("AuditActor")
  auditLogsReceived   AuditLog[]           @relation("AuditTarget")
  ticketMessages      TicketMessage[]

  @@map("users")
}

// Invitation envoyée par email : valable 48 h, utilisable une seule fois
model Invitation {
  id        Int       @id @default(autoincrement())
  // Empreinte du jeton : le jeton lui-même n'est jamais stocké
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("invitations")
}

// Session de connexion : révoquée à la déconnexion ou quand elle est renouvelée
model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Lien « mot de passe oublié » : valable 1 h, utilisable une seule fois
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

// Actions sensibles enregistrées dans le journal d'audit
enum AuditAction {
  USER_CREATED
  USER_DEACTIVATED
  USER_REACTIVATED
  ROLE_CHANGED
  PASSWORD_RESET
}

// Journal d'audit : une ligne par action sensible, jamais modifiée ni supprimée par l'API
model AuditLog {
  id           Int         @id @default(autoincrement())
  action       AuditAction
  // Qui a fait l'action
  actorId      Int?
  actor        User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  // Le compte concerné
  targetUserId Int?
  targetUser   User?       @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  // Détails utiles, par exemple { "from": "USER", "to": "AGENT" } pour un changement de rôle
  details      Json?
  createdAt    DateTime    @default(now())

  @@index([targetUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Qui a écrit un message dans le fil d'un ticket
enum MessageAuthorType {
  AI
  USER
  AGENT
}

// Fil de discussion d'un ticket : l'IA y écrit sa réponse, les agents pourront y répondre plus tard
model TicketMessage {
  id         Int               @id @default(autoincrement())
  ticketId   Int
  ticket     Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType MessageAuthorType
  // Vide pour l'IA, qui n'est pas un compte
  authorId   Int?
  author     User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  // Texte du message (Markdown)
  content    String
  createdAt  DateTime          @default(now())

  @@index([ticketId])
  @@map("ticket_messages")
}

// Résultat d'un appel à l'IA
enum AiCallStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// Une ligne par appel à l'IA, réussi ou non : sert à suivre les coûts
// et à faire respecter AI_MAX_CALLS_PER_DAY
model AiCall {
  id           Int          @id @default(autoincrement())
  // Gardé même si le ticket est supprimé, pour ne pas perdre la trace du coût
  ticketId     Int?
  ticket       Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  status       AiCallStatus @default(PENDING)
  // Modèle utilisé, par exemple celui autorisé par le prof
  model        String
  // Tokens consommés, remplis à la fin de l'appel
  inputTokens  Int?
  outputTokens Int?
  // Message court en cas d'échec (jamais la clé)
  error        String?      @db.VarChar(500)
  createdAt    DateTime     @default(now())
  finishedAt   DateTime?

  @@index([ticketId])
  @@index([createdAt])
  @@map("ai_calls")
}